{
  "name": "ow-activity-cloudflare-lite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../node_modules/wrangler/bin/wrangler.js dev",
    "deploy": "node ../node_modules/wrangler/bin/wrangler.js deploy",
    "db:local": "node ../node_modules/wrangler/bin/wrangler.js d1 execute ow-activity-lite --local --file=schema.sql",
    "db:remote": "node ../node_modules/wrangler/bin/wrangler.js d1 execute ow-activity-lite --remote --file=schema.sql",
    "check:size": "node ../node_modules/wrangler/bin/wrangler.js deploy --dry-run"
  }
}
