{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "sjtu-ow",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-08",
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ow-activity-lite",
			"database_id": "ecceae37-c8ed-40cc-8b23-debcffb345bd"
		}
	],
	"observability": {
		"enabled": true
	}
}
