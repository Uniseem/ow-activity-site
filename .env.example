# Vercel Storage -> Neon. Keep these empty for a local demo without a database.
# Runtime: the pooled PostgreSQL URL supplied by the integration.
DATABASE_URL=""
# Migrations and seed: the direct PostgreSQL URL (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=""

# Used only by npm run db:seed. Set a password before running the seed.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Optional. Vercel's project domain is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=""

# 服务器运行时的公开 HTTPS 地址，VPS/Cloudflare 优先设置此项。
# 恢复到新域名时保持新站自己的地址，不从备份覆盖。
SITE_URL=""

# postgresql（默认，Vercel/VPS）或 d1（Cloudflare Workers）。
DATABASE_PROVIDER="postgresql"

# Vercel 每日活动状态同步任务的访问密钥。
CRON_SECRET=""

# OAuth 客户端密钥的加密密钥，64 位随机十六进制字符串。设置后保持不变。
# Client ID / Client Secret 由管理员在 /admin/oauth 填写。
OAUTH_ENCRYPTION_KEY=""

# 可选：当前构建的完整 Git commit SHA（40 位）。Vercel Git 部署或本地 Git 会自动识别。
# 使用 CLI 上传且构建环境没有 Git 时，通过 --build-env APP_GIT_COMMIT_SHA=<SHA> 传入。
APP_GIT_COMMIT_SHA=""
