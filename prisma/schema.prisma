generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum OAuthProvider {
  google
  github
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum ProfileReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlayerRole {
  TANK
  DAMAGE
  SUPPORT
  FLEX
}

enum EventType {
  SCRIM
  FUN
  TRAINING
  CUSTOM
  WATCH
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  RUNNING
  FINISHED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                   String              @id @default(cuid())
  username             String              @unique
  passwordHash         String?
  role                 UserRole            @default(USER)
  status               UserStatus          @default(PENDING)
  profile              Profile?
  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  createdEvents        Event[]             @relation("EventCreator")
  registrations        EventRegistration[]
  reviewedProfiles     Profile[]           @relation("ProfileReviewer")
  reviewedRegistrations EventRegistration[] @relation("RegistrationReviewer")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Profile {
  id             String              @id @default(cuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl      String?
  displayName    String
  slogan         String
  battleTag      String?
  mainRole       PlayerRole?
  mainHeroes     String[]            @default([])
  rank           String?
  onlineTime     String?
  contact        String?
  extraNote      String?
  reviewStatus   ProfileReviewStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?               @relation("ProfileReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminSetup {
  id          String    @id
  completedAt DateTime?
}

model OAuthConfig {
  provider        OAuthProvider @id
  clientId        String        @default("")
  encryptedSecret String?
  enabled         Boolean       @default(false)
  revision        Int           @default(0)
  updatedById     String?
  updatedAt       DateTime      @updatedAt
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model OAuthState {
  stateHash String        @id
  provider  OAuthProvider
  expiresAt DateTime

  @@index([expiresAt])
}

model Event {
  id             String              @id @default(cuid())
  title          String
  description    String
  type           EventType           @default(FUN)
  customType     String?
  startTime      DateTime
  signupDeadline DateTime?
  signupClosed   Boolean             @default(false)
  maxParticipants Int
  requirements   String?
  voiceChannel   String?
  status         EventStatus         @default(DRAFT)
  createdById    String
  createdBy      User                @relation("EventCreator", fields: [createdById], references: [id])
  registrations  EventRegistration[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, startTime])
  @@index([createdById])
}

model EventRegistration {
  id             String             @id @default(cuid())
  eventId        String
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredRole  PlayerRole?
  heroes         String[]           @default([])
  voiceAvailable Boolean            @default(false)
  note           String?
  status         RegistrationStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([eventId, userId])
  @@index([status])
  @@index([userId])
}

model SiteSettings {
  id          String   @id
  values      Json     @default("{}")
  revision    Int      @default(0)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model SiteAsset {
  id           String   @id @default(cuid())
  name         String
  mimeType     String
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())
}
