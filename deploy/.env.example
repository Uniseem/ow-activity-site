# Docker Compose 专用。复制到仓库根目录 .env；不要提交真实密钥。
COMPOSE_PROJECT_NAME=ow-activity-site
POSTGRES_DB=ow_activity
POSTGRES_USER=ow_activity
# 只使用 openssl rand -hex 32 生成的值，保证 PostgreSQL URL 无需额外转义。
POSTGRES_PASSWORD=
OAUTH_ENCRYPTION_KEY=
CRON_SECRET=

SITE_DOMAIN=ow.example.com
NEXT_PUBLIC_SITE_URL=https://ow.example.com
APP_PORT=3100
# 自带 Caddy 自动 HTTPS；已有 HTTPS 反向代理时清空此项。
COMPOSE_PROFILES=https
# 安装脚本自动传入当前提交；手动部署时可 export APP_GIT_COMMIT_SHA=$(git rev-parse HEAD)。
APP_GIT_COMMIT_SHA=
