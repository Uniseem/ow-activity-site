{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ow-activity-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ow-activity-site" },
  ],
  "vars": { "DATABASE_PROVIDER": "d1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ow-activity-site",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "prisma/cloudflare/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "SITE_ASSETS", "bucket_name": "ow-activity-site-assets" },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ow-activity-site-cache",
    },
  ],
  "observability": { "enabled": true },
}
