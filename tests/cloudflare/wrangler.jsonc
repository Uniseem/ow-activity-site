{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ow-activity-prisma-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "define": { "import.meta.url": "\"file:///worker.js\"" },
  "alias": { "server-only": "./empty-server-only.ts" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ow-activity-prisma-test",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../../prisma/cloudflare/migrations"
  }],
  "r2_buckets": [{ "binding": "SITE_ASSETS", "bucket_name": "ow-activity-prisma-test-assets" }],
  "vars": { "DATABASE_PROVIDER": "d1" }
}
